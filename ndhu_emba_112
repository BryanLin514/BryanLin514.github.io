<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>國立東華大學 113級 EMBA 畢業攝影成品</title>
    <style>
        /* === 核心設計語言 === */
        body { 
            font-family: "Helvetica Neue", "PingFang TC", "Microsoft JhengHei", Arial, sans-serif; 
            background: #121212; 
            color: #f0f0f0; 
            margin: 0; 
            padding: 0; 
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* === 導覽列 Navbar === */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 25px 40px;
            background: rgba(18, 18, 18, 0.98);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid #222;
        }
        .navbar-brand {
            font-size: 15px;
            letter-spacing: 3px;
            font-weight: 300;
            color: #fff;
        }

        /* === 精緻層次頁首 Hero Section === */
        .hero {
            text-align: center;
            padding: 100px 20px 60px 20px;
            max-width: 1000px;
            margin: 0 auto;
        }
        .hero-main {
            font-size: 28px;      
            color: #fff;
            letter-spacing: 8px; 
            font-weight: 300;
            line-height: 1.6;
            text-indent: 8px;
        }

        /* === 分類篩選按鈕 === */
        .filter-container {
            text-align: center;
            padding-bottom: 60px;
        }
        .filter-btn {
            background: transparent;
            color: #666;
            border: 1px solid #222; 
            border-radius: 4px;
            padding: 10px 24px;
            margin: 6px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 12px;
            letter-spacing: 2px;
            -webkit-tap-highlight-color: transparent;
        }
        .filter-btn:hover, .filter-btn.active {
            color: #fff;
            background: #1a1a1a;
            border-color: #444;
        }

        /* === 瀑布流版面 Gallery === */
        .gallery {
            column-count: 3;
            column-gap: 20px;
            max-width: 1400px; 
            margin: 0 auto;
            padding: 0 30px 80px 30px;
        }
        .gallery-item {
            break-inside: avoid;
            margin-bottom: 30px;
            background: #181818; 
            border-radius: 4px;
            overflow: hidden;
            display: none; 
            border: 1px solid #222;
        }
        .gallery-item.show { display: block; }
        .gallery img {
            width: 100%;
            display: block;
            cursor: pointer;
            transition: opacity 0.3s;
            -webkit-tap-highlight-color: transparent;
        }
        .gallery img:hover { opacity: 0.7; }
        .gallery-info {
            padding: 15px;
            font-size: 12px;
            color: #777;
            letter-spacing: 1px;
            text-align: center;
        }

        /* === Lightbox 燈箱 === */
        .lightbox {
            display: none; position: fixed; z-index: 1000; 
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(8, 8, 8, 0.98); 
            justify-content: center; align-items: center; cursor: pointer; 
            flex-direction: column;
        }
        .lightbox.show { display: flex; }
        .lightbox-content {
            max-width: 92%; max-height: 72%; object-fit: contain;
        }
        .lightbox-details {
            margin-top: 25px;
            text-align: center;
            max-width: 850px;
            padding: 0 30px;
            cursor: default;
        }
        .lb-title { font-size: 22px; color: #fff; margin-bottom: 8px; letter-spacing: 3px; font-weight: 300; }
        .lb-exif { font-size: 13px; color: #666; margin-bottom: 12px; letter-spacing: 1px; }
        .lb-desc { font-size: 14px; color: #999; line-height: 1.8; font-weight: 300; }

        .lightbox-close {
            position: absolute; top: 25px; right: 35px;
            color: white; font-size: 45px; font-weight: 100;
            cursor: pointer; opacity: 0.5;
        }
        .lightbox-nav {
            position: absolute; top: 50%; transform: translateY(-50%);
            color: rgba(255, 255, 255, 0.15); font-size: 50px;
            cursor: pointer; padding: 30px; transition: color 0.3s;
        }
        .lightbox-nav:hover { color: #fff; }
        .lightbox-prev { left: 10px; }
        .lightbox-next { right: 10px; }

        /* === 頁尾 Footer === */
        footer {
            text-align: center; padding: 80px 20px; border-top: 1px solid #222; margin-top: 60px;
        }
        .social-links { 
            display: flex; 
            justify-content: center; 
            gap: 50px; 
            margin-bottom: 40px; 
        }
        .social-links a { 
            color: #888;         
            transition: all 0.3s ease; 
        }
        .social-links a:hover { 
            color: #fff; 
            transform: translateY(-5px); 
        }
        .social-links svg { 
            width: 32px;         
            height: 32px; 
        }
        .footer-copyright { color: #2a2a2a; font-size: 11px; letter-spacing: 2px; text-transform: uppercase; }
        
        #status-msg { text-align: center; padding: 80px; font-size: 14px; color: #444; letter-spacing: 2px; }

        /* === RWD 手機版精緻化優化 === */
        @media (max-width: 600px) { 
            .hero { padding: 60px 20px 40px 20px; }
            .hero-main { 
                font-size: 18px;        
                letter-spacing: 4px;   
                line-height: 1.8; 
                text-indent: 4px;
            }
            .navbar { padding: 15px 25px; text-align: center; }
            .gallery { column-count: 1; padding: 0 20px 40px 20px; } 
            .lightbox-content { max-height: 60%; }
            .lightbox-nav { display: none; }
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="navbar-brand">Bryan Lin Photography</div>
    </nav>

    <header class="hero">
        <div class="hero-main">
            國立東華大學 113級 EMBA 畢業攝影成品
        </div>
    </header>

    <div id="portfolio" class="filter-container">
        <button class="filter-btn active" onclick="filterGallery('all', this)">全部 ALL</button>
    </div>

    <div id="status-msg">正在連線至雲端作品庫...</div>
    <div class="gallery" id="gallery"></div>

    <footer>
        <div class="social-links">
            <a href="https://www.facebook.com/Lbw0514" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            </a>
            <a href="https://www.instagram.com/lbw0514/" target="_blank">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
        </div>
        <div class="footer-copyright">© 2026 Bryan Lin. All rights reserved.</div>
    </footer>

    <div id="lightbox" class="lightbox" onclick="handleLightboxClick(event)">
        <span class="lightbox-close" onclick="closeLightbox(event)">×</span>
        <span class="lightbox-nav lightbox-prev" onclick="showPrevImage(event)">❮</span>
        <span class="lightbox-nav lightbox-next" onclick="showNextImage(event)">❯</span>
        
        <img class="lightbox-content" id="lightbox-img">
        <iframe id="lightbox-video" class="lightbox-content" style="display:none; border:none; width:80%; height:60%;" allow="autoplay"></iframe>
        
        <div class="lightbox-details" onclick="event.stopPropagation()">
            <div id="lb-title" class="lb-title"></div>
            <div id="lb-exif" class="lb-exif"></div>
            <div id="lb-desc" class="lb-desc"></div>
            <div id="lb-counter" style="margin-top:15px; font-size:11px; color:#333; letter-spacing: 2px;"></div>
        </div>
    </div>

    <script>
        // 💡 已為您替換為最新的 EMBA 資料夾 ID
        const FOLDER_ID = '1TxqOZL2flQmXuh3jOQAzxvww4jI1mx7E';
        const API_KEY = 'AIzaSyAt7HrW9XcPt-vR5HtKVgNCqJFaxyBiNew'; // 👈 填入您的 API KEY

        let allFilesData = []; 
        let filteredData = [];
        let currentIndex = 0;

        async function fetchImages(folderId, category = '') {
            let list = [];
            const fields = "files(id,name,description,imageMediaMetadata,mimeType)";
            const query = encodeURIComponent(`'${folderId}' in parents and trashed = false`);
            const url = `https://www.googleapis.com/drive/v3/files?q=${query}&key=${API_KEY}&fields=${fields}&pageSize=1000&supportsAllDrives=true&includeItemsFromAllDrives=true`;

            const res = await fetch(url);
            const data = await res.json();

            if (data.files) {
                for (let f of data.files) {
                    if (f.mimeType === 'application/vnd.google-apps.folder') {
                        const subList = await fetchImages(f.id, f.name);
                        list = list.concat(subList);
                    } else if (f.name.match(/\.(jpg|jpeg|png|webp|gif|mp4|mov|webm)$/i)) {
                        let exifStr = "";
                        if (f.imageMediaMetadata) {
                            const m = f.imageMediaMetadata;
                            const shutter = m.exposureTime ? (m.exposureTime < 1 ? `1/${Math.round(1/m.exposureTime)}s` : `${m.exposureTime}s`) : "";
                            const iso = m.isoSpeed ? `ISO ${m.isoSpeed}` : "";
                            
                            let fstop = "";
                            if (m.aperture) {
                                if (m.aperture.toString().includes("1.8340")) {
                                    fstop = ""; 
                                } else {
                                    fstop = `f/${parseFloat(m.aperture.toFixed(1))}`;
                                }
                            }
                            exifStr = [shutter, fstop, iso].filter(Boolean).join(" · ");
                        }
                        list.push({
                            id: f.id,
                            displayName: f.name.replace(/\.[^/.]+$/, ""),
                            category: category,
                            description: f.description || "",
                            exif: exifStr,
                            isVideo: f.mimeType ? f.mimeType.includes('video') : false
                        });
                    }
                }
            }
            return list;
        }

        async function init() {
            try {
                allFilesData = await fetchImages(FOLDER_ID);
                filteredData = allFilesData;
                document.getElementById('status-msg').style.display = "none";

                const cats = [...new Set(allFilesData.map(f => f.category).filter(c => c !== ""))];
                const filterBar = document.getElementById('portfolio');
                cats.forEach(c => {
                    const btn = document.createElement('button');
                    btn.className = 'filter-btn';
                    btn.textContent = c;
                    btn.onclick = (e) => filterGallery(c, e.target);
                    filterBar.appendChild(btn);
                });

                renderGallery();
            } catch (err) {
                console.error(err);
                document.getElementById('status-msg').textContent = "讀取發生錯誤，請檢查 API Key 或網路連線。";
            }
        }

        function renderGallery() {
            const container = document.getElementById('gallery');
            container.innerHTML = "";
            filteredData.forEach((f, idx) => {
                const item = document.createElement('div');
                item.className = 'gallery-item show';
                item.innerHTML = `
                    <img src="https://drive.google.com/thumbnail?id=${f.id}&sz=w800" onclick="openLightbox(${idx})">
                    <div class="gallery-info">${f.displayName}</div>
                `;
                container.appendChild(item);
            });
        }

        function filterGallery(cat, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filteredData = cat === 'all' ? allFilesData : allFilesData.filter(f => f.category === cat);
            renderGallery();
        }

        function openLightbox(idx) {
            currentIndex = idx;
            document.getElementById('lightbox').classList.add('show');
            updateLightbox();
        }

        function closeLightbox(e) {
            if (e) e.stopPropagation();
            document.getElementById('lightbox').classList.remove('show');
            document.getElementById('lightbox-video').src = ""; 
        }

        function handleLightboxClick(e) {
            if (e.target.id === 'lightbox' || e.target.id === 'lightbox-img') {
                showNextImage();
            }
        }

        function showNextImage(e) {
            if (e) e.stopPropagation();
            currentIndex = (currentIndex + 1) % filteredData.length;
            updateLightbox();
        }

        function showPrevImage(e) {
            if (e) e.stopPropagation();
            currentIndex = (currentIndex - 1 + filteredData.length) % filteredData.length;
            updateLightbox();
        }

        function updateLightbox() {
            const f = filteredData[currentIndex];
            if (!f) return;
            
            const imgElement = document.getElementById('lightbox-img');
            const videoElement = document.getElementById('lightbox-video');

            if (f.isVideo) {
                imgElement.style.display = 'none';
                videoElement.style.display = 'block';
                videoElement.src = `https://drive.google.com/file/d/${f.id}/preview`;
            } else {
                videoElement.style.display = 'none';
                imgElement.style.display = 'block';
                imgElement.src = `https://drive.google.com/thumbnail?id=${f.id}&sz=w1920`;
                videoElement.src = ""; 
            }

            document.getElementById('lb-title').textContent = f.displayName;
            document.getElementById('lb-exif').textContent = f.exif;
            document.getElementById('lb-desc').textContent = f.description;
            document.getElementById('lb-counter').textContent = `${currentIndex + 1} / ${filteredData.length}`;
        }

        window.addEventListener('keydown', (e) => {
            if (!document.getElementById('lightbox').classList.contains('show')) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowRight") showNextImage();
            if (e.key === "ArrowLeft") showPrevImage();
        });

        init();
    </script>
</body>
</html>
